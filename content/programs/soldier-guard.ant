// Fight in reach first; recover only when the local area is safe.
let enemy = nearest_enemy_id;
if (enemy > 0 && nearest_enemy_distance <= 1000) {
    attack(enemy);
} else if (enemy > 0) {
    if (health <= 12) { set_target(nest_x,nest_y); }
    else { set_target(nearest_enemy_x,nearest_enemy_y); }
} else if (health < max_health && nearest_supply_id > 0) {
    if (nearest_supply_distance <= 1000) { eat_from(nearest_supply_id,nearest_supply_food); }
    else { set_target(nearest_supply_x,nearest_supply_y); }
} else if (health < max_health && at_nest) {
    if (nest_meat > 0) { eat(food_meat); }
    else if (nest_fruit > 0) { eat(food_fruit); }
    else { wait(); }
} else if (health <= 12) {
    set_target(nest_x,nest_y);
} else if (group_id > 0) {
    if (queen_connected) { request_queen_info(); }
    if (group_order_version == 0) { set_target(nest_x,nest_y); }
    else if (group_task == task_explore) { set_target(job_explore_x,job_explore_y); }
    else { set_target(objective_x,objective_y); }
} else {
    set_target(nest_x + (ant_id % 3 - 1) * 2000,nest_y + (ant_id % 2 * 2 - 1) * 2000);
}
